{
  "name": "web3-miniapp-monorepo",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -w -r --filter './apps/**' dev",
    "build": "pnpm -w -r build",
    "lint": "pnpm -w -r lint",
    "typecheck": "pnpm -w -r typecheck",
    "test": "pnpm -w -r test",
    "format": "pnpm -w -r format",
    "prepare": "husky install"
  }
}
